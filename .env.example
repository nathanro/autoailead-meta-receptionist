# Meta Model API Key (starts with LLM_...)
# Create at: https://dev.meta.ai -> API keys -> Create API key
META_API_KEY=
MODEL_API_KEY=

# Base URL for Meta Model API
META_BASE_URL=https://api.meta.ai/v1

# Hard Spend Guardrails (enforced in code BEFORE any network call)
# Default $5.00 USD total cap out of the $150.00 hackathon credit
MAX_TOTAL_SPEND_USD=5.00
MAX_SESSION_SPEND_USD=0.50
MAX_CALLS_PER_SESSION=15

# Default text model ("muse-spark-1.3" standard or "muse-spark-1.3-contributor")
META_TEXT_MODEL=muse-spark-1.3
PORT=3080
